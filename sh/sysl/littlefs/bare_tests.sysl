module sh.sysl.littlefs

@tests

// littlefs on a board. The vendored C includes `<string.h>` and `<inttypes.h>` by their system names
// and calls `memcpy`, `memset`, `memcmp`, `strchr`, `strcpy`, `strspn` and `strcspn`. The manifest takes
// cstd with `if = "!libc"`, so on a bare-metal target the C compiles against cstd's headers and the
// archive carries cstd's definitions of those functions; on the host the dependency is dropped and the
// real libc answers.

import sysl.buf.{Buf, buf}
import sysl.fs.make_dir_all
import sysl.process.capture
import sysl.testing.compiler
import sysl.text.{Search, split}

// The functions `lfs.c` calls out to the C library for.
private val called: []string = ["memcpy", "memset", "memcmp", "strchr", "strcpy", "strspn", "strcspn"]

// The global symbols the archive `build-c` writes for this package defines, one name per line.
private archive_defines(target: string) -> string
    val dir = f".sysl/bare-tests/$target"
    make_dir_all(dir).unwrap()
    val lib = f"$dir/liblittlefs.a"
    var args: Buf[string] = buf()
    for a in ["build-c", ".", "-o", lib] do args.push(a)
    if target != "host"
        args.push("--target")
        args.push(target)
    val built = capture(compiler(), args.view(), stderr = true).unwrap()
    if !built.status.ok() then panic(f"build-c of littlefs for $target failed:\n${built.err.unwrap_or("")}")
    val listed = capture("nm", ["-g", lib]).unwrap()
    assert(listed.status.ok())
    var defined = "\n"
    for line in split(listed.text, "\n")
        val t = line.index_of(" T ")
        if t.is_some() then defined += f"${line[t.unwrap() + 3..<line.len]}\n"
    defined

private bare_case(target: string)
    val defined = archive_defines(target)
    for n in ["lfs_format", "lfs_mount", "lfs_file_write", "lfs_dir_read"]
        if !defined.contains(f"\n$n\n") then panic(f"$target: the archive does not define littlefs's $n")
    for n in called
        if !defined.contains(f"\n$n\n") then panic(f"$target: the archive does not define $n, so cstd was not littlefs's libc")

@test("on thumbv7em the C is compiled against cstd's headers and the archive defines littlefs and the libc it calls")
bare_thumbv7em() = bare_case("thumbv7em-freestanding")

@test("on riscv32 the C is compiled against cstd's headers and the archive defines littlefs and the libc it calls")
bare_riscv32() = bare_case("riscv32-freestanding")

@test("on the host the dependency is dropped and the archive defines no libc function")
bare_host()
    val defined = archive_defines("host")
    assert(defined.contains("\n_lfs_mount\n"), defined)
    for n in called
        if defined.contains(f"\n_$n\n") then panic(f"the host archive defines $n, which belongs to the real libc")
